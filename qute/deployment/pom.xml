<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse.flags</groupId>
        <artifactId>quarkus-flags-qute-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-flags-qute-deployment</artifactId>
    <name>Quarkus Feature Flags - Qute - Deployment</name>
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-qute-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.flags</groupId>
            <artifactId>quarkus-flags-deployment</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.flags</groupId>
            <artifactId>quarkus-flags-qute</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-internal</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.quarkus</groupId>
                            <artifactId>quarkus-extension-processor</artifactId>
                            <version>${quarkus.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>test-coverage</id>
            <activation>
                <property>
                    <name>jacoco</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jacoco</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <quarkus.jacoco.instrument-artifacts.api.group-id>io.quarkiverse.flags</quarkus.jacoco.instrument-artifacts.api.group-id>
                                <quarkus.jacoco.instrument-artifacts.api.artifact-id>quarkus-flags-api</quarkus.jacoco.instrument-artifacts.api.artifact-id>
                                <quarkus.jacoco.instrument-artifacts.core.group-id>io.quarkiverse.flags</quarkus.jacoco.instrument-artifacts.core.group-id>
                                <quarkus.jacoco.instrument-artifacts.core.artifact-id>quarkus-flags</quarkus.jacoco.instrument-artifacts.core.artifact-id>
                                <quarkus.jacoco.instrument-artifacts.qute.group-id>io.quarkiverse.flags</quarkus.jacoco.instrument-artifacts.qute.group-id>
                                <quarkus.jacoco.instrument-artifacts.qute.artifact-id>quarkus-flags-qute</quarkus.jacoco.instrument-artifacts.qute.artifact-id>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
